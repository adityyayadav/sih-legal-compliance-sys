# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored — never commit it. Run the app from this folder
# (backend/backend/) so Spring picks up `.env` via spring.config.import.

# ── Supabase Postgres ─────────────────────────────────────────────
# Project Settings → Database → Connection string → JDBC.
# Use the "Session pooler" / direct connection (port 5432) or the
# transaction pooler (port 6543) URI, converted to jdbc: form.
DB_URL=jdbc:postgresql://db.xxxxxxxxxxxx.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-db-password

# ── JWT ───────────────────────────────────────────────────────────
# 256-bit+ base64 string. The value below was randomly generated for
# local dev — fine to keep for the hackathon, regenerate for anything real:
#   openssl rand -base64 48
JWT_SECRET=uNfAuvZ3Vf1VCVqTgWL0BPSXJWmiuTLztR5iVqsucMBS6tZHK9xg4/NDeWkpux2X
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_DAYS=7

# ── Cloudinary ────────────────────────────────────────────────────
# Dashboard → Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── ML service ────────────────────────────────────────────────────
# FastAPI base URL. Contract paths are under /api/v1 (see Impl-Plan §5).
ML_SERVICE_URL=http://localhost:7860/api/v1
